  "lines_deva": [
   "कामक्रोधौ तथा लोभं स्वादुशृङ्गारकौतुके",
   "अतिनिद्रातिसेवे च विद्यार्थी ह्यष्ट वर्जयेत्"
  ],
  "lines_iast": [
   "kāmakrodhau tathā lobhaṃ svāduśṛṅgārakautuke",
   "atinidrātiseve ca vidyārthī hyaṣṭa varjayet"
  ],
