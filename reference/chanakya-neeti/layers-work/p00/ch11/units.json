  "lines_deva": [
   "आत्मवर्गं परित्यज्य परवर्गं समाश्रयेत्",
   "स्वयमेव लयं याति यथा राजान्यधर्मतः"
  ],
  "lines_iast": [
   "ātmavargaṃ parityajya paravargaṃ samāśrayet",
   "svayameva layaṃ yāti yathā rājānyadharmataḥ"
  ],
