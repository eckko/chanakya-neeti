  "lines_deva": [
   "यो मोहान्मन्यते मूढो रक्तेयं मयि कामिनी",
   "स तस्या वशगो भूत्वा नृत्येत् क्रीडाशकुन्तवत्"
  ],
  "lines_iast": [
   "yo mohānmanyate mūḍho rakteyaṃ mayi kāminī",
   "sa tasyā vaśago bhūtvā nṛtyet krīḍāśakuntavat"
  ],
