  "lines_deva": [
   "परस्परस्य मर्माणि ये भाषन्ते नराधमाः",
   "त एव विलयं यान्ति वल्मीकोदरसर्पवत्"
  ],
  "lines_iast": [
   "parasparasya marmāṇi ye bhāṣante narādhamāḥ",
   "ta eva vilayaṃ yānti valmīkodarasarpavat"
  ],
