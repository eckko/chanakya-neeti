  "lines_deva": [
   "इक्षुदण्डास्तिलाः शूद्राः कान्ता हेम च मेदिनी",
   "चन्दनं दधि ताम्बूलं मर्दनं गुणवर्धनम्"
  ],
  "lines_iast": [
   "ikṣudaṇḍāstilāḥ śūdrāḥ kāntā hema ca medinī",
   "candanaṃ dadhi tāmbūlaṃ mardanaṃ guṇavardhanam"
  ],
