  "lines_deva": [
   "विद्यार्थी सेवकः पान्थः क्षुधार्तो भयकातरः",
   "भाण्डारी प्रतिहारी च सप्त सुप्तान्प्रबोधयेत्"
  ],
  "lines_iast": [
   "vidyārthī sevakaḥ pānthaḥ kṣudhārto bhayakātaraḥ",
   "bhāṇḍārī pratihārī ca sapta suptānprabodhayet"
  ],
