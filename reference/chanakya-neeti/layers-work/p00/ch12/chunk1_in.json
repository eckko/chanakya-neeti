  "lines_deva": [
   "काष्ठं कल्पतरुः सुमेरुरचलश्चिन्तामणिः प्रस्तरः",
   "सूर्यस्तीव्रकरः शशी क्षयकरः क्षारो हि वारां निधिः",
   "कामो नष्टतनुर्वलिर्दितिसुतो नित्यं पशुः कामगौ-",
   "र्नैतांस्ते तुलयामि भो रघुपते कस्योपमा दीयते"
  ],
  "lines_iast": [
   "kāṣṭhaṃ kalpataruḥ sumeruracalaścintāmaṇiḥ prastaraḥ",
   "sūryastīvrakaraḥ śaśī kṣayakaraḥ kṣāro hi vārāṃ nidhiḥ",
   "kāmo naṣṭatanurvalirditisuto nityaṃ paśuḥ kāmagau-",
   "rnaitāṃste tulayāmi bho raghupate kasyopamā dīyate"
  ],
